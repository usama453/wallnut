# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (Gemini 2.5 Flash) - free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# AI provider to use (gemini | mock)
AI_PROVIDER=gemini

# Site URL (for shareable report links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: local-only mock without any API key
# AI_PROVIDER=mock

# --- WhatsApp Business Cloud API ---
# Set WHATSAPP_MOCK=1 to skip signature checks for local testing.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Org that WhatsApp uploads land in when the sender isn't a known contact.
# Leave empty to store them with no org.
WHATSAPP_DEFAULT_ORG_ID=

# --- Meta tech-provider (Embedded Signup) ---
# App id + secret from your Meta Developer app (Settings > Basic).
FB_APP_ID=
FB_APP_SECRET=
# Client-side copies (safe to expose — the launcher needs them in the browser).
NEXT_PUBLIC_FB_APP_ID=
NEXT_PUBLIC_TP_CONFIG_ID=
# Tech Provider Configuration id (WhatsApp > Tech Provider, then Create Config).
# Read from the "config id" row that appears after choosing an app mode.
TP_CONFIG_ID=
# 6-digit PIN used to register WhatsApp phone numbers (make one up, e.g. 123456).
FB_REG_PIN=
# Public contact email required by Meta for the Tech Provider Configuration.
TP_CONTACT_EMAIL=
# Graph API version used for OAuth + API calls (leave default).
FB_GRAPH_API_VERSION=v22.0
# Where Meta redirects after Embedded Signup; must match the app's OAuth redirect.
FB_REDIRECT_URI=http://localhost:3000

