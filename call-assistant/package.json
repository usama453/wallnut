{
  "name": "call-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Live AI call assistant for Zoom, Google Meet and Microsoft Teams",
  "author": "Call Assistant",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "screencapturekit-audio-capture": "^1.3.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.454.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "com.callassistant.desktop",
    "productName": "Call Assistant",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "files": [
      "out/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/screencapturekit-audio-capture/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Call Assistant uses your camera to show your video preview during the call.",
        "NSMicrophoneUsageDescription": "Call Assistant captures microphone audio to transcribe the call and provide live AI assistance.",
        "NSScreenCaptureUsageDescription": "Call Assistant captures system audio so it can hear the other participants of your call and provide live AI assistance."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
